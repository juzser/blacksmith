# This project is its own pnpm workspace root, and says so on purpose.
#
# pnpm finds a workspace by walking UP from the current directory until it
# hits a `pnpm-workspace.yaml`. A checkout that sits anywhere below another
# workspace root inherits it: that root's lockfile gets rewritten, this
# project's dependencies get linked into that root's `node_modules`, and
# every check afterwards measures a toolchain this project does not own. A
# root above with no `packages` is worse still — the same walk kills
# `pnpm install` outright with ERR_PNPM_INVALID_WORKSPACE_CONFIGURATION
# before it resolves a single dependency.
#
# `.` is the whole list: one package, this one. It stays correct wherever the
# checkout ends up, including on its own remote with nothing above it.
# Add entries here if this project ever grows a monorepo of its own.
packages:
  - '.'
