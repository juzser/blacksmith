{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": false,
    "rootDir": "factory/orchestrator/src",
    "outDir": "factory/orchestrator/dist",
    "types": ["node"]
  },
  "include": ["factory/orchestrator/src/**/*.ts"]
}
