{
  "name": "@juzser/blacksmith",
  "version": "0.5.1",
  "type": "module",
  "description": "Plan a feature as signed spec contracts, build each in its own git worktree, put the result through review and verification gates, and merge through a queue into one pull request.",
  "keywords": [
    "agent",
    "agents",
    "ai",
    "claude-code",
    "code-review",
    "git-worktree",
    "llm",
    "multi-agent",
    "orchestration"
  ],
  "homepage": "https://github.com/juzser/blacksmith#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juzser/blacksmith.git"
  },
  "bugs": {
    "url": "https://github.com/juzser/blacksmith/issues"
  },
  "author": "juzser (https://github.com/juzser)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.3.0",
  "bin": {
    "bs": "factory/orchestrator/dist/cli.js",
    "bs-run": "factory/orchestrator/dist/run-cli.js",
    "smith": "factory/orchestrator/dist/cli.js",
    "smith-run": "factory/orchestrator/dist/run-cli.js",
    "bs-prompt-hook": "factory/orchestrator/dist/promptHook.js",
    "bs-policy-hook": "factory/orchestrator/dist/policyHook.js"
  },
  "files": [
    "factory/orchestrator/dist",
    "!factory/orchestrator/dist/**/*.d.ts",
    "factory/orchestrator/drizzle",
    "!factory/orchestrator/drizzle/meta/*_snapshot.json",
    "factory/policies",
    "factory/specs/schema",
    "factory/specs/roadmap.md",
    "factory/scaffold",
    ".claude/agents",
    ".claude/skills",
    "ui/dist",
    "ui/server/dist"
  ],
  "scripts": {
    "prepare": "pnpm run build",
    "prepack": "pnpm run build && pnpm run build:server && pnpm run build:ui",
    "check": "bash scripts/check.sh",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:server": "pnpm build && tsc -p ui/server/tsconfig.json",
    "typecheck:server": "tsc -p ui/server/tsconfig.test.json",
    "test:server": "pnpm build:server && vitest run --config ui/server/vitest.config.ts",
    "test:server:coverage": "pnpm build:server && vitest run --config ui/server/vitest.config.ts --coverage",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck:ui": "tsc -p ui/tsconfig.json",
    "typecheck:ui:test": "tsc -p ui/tsconfig.test.json",
    "test:ui": "vitest run --config ui/vitest.config.ts",
    "test:ui:coverage": "vitest run --config ui/vitest.config.ts --coverage",
    "test:e2e": "pnpm build:server && pnpm build:ui && playwright test --config ui/playwright.config.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@hono/node-server": "2.1.5",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "picomatch": "4.0.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@floating-ui/dom": "1.8.0",
    "@lucide/vue": "1.61.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  }
}
