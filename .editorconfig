# Covers this repo's file types: Markdown, JSON, shell and YAML.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: two trailing spaces is a hard line break, so stripping them
# silently rewrites the rendered document.
[*.md]
trim_trailing_whitespace = false
