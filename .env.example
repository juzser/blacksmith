# Blacksmith — template for `.env`. This file is the ONLY committed env file
# (docs/standards/guardrails.md "Secrets, keys, tokens"). A secret appears
# here by NAME only, never with a value. The SMITH_* tuning knobs further down
# are not secrets: each turn cap carries its shipped default, and each budget
# knob ships empty with its per-tier defaults shown commented out; a test
# holds them equal to budgets.yml or the agent template they mirror
# (test/envExample.test.ts).
# Copy it: `cp .env.example .env`, then fill `.env`.
#
# The CLI loads this file's sibling `.env` at start (D-270,
# factory/orchestrator/src/dotenv.ts) — no dotenv dependency, no script to
# source. It sets only names the environment does not already hold, so an
# exported value always beats the file:
#
#   DEEPSEEK_API_KEY=... smith judge preflight          # wins over .env
#   SMITH_EPIC_CAP_TOKENS=... smith budget alarm <id>   # so does this
#
# Anything that is not the CLI — a shell, a test runner, a tool of your own —
# still reads process.env at call time, so load it yourself there:
#
#   node --env-file=.env factory/orchestrator/dist/cli.js <ns> <action> ...
#   set -a; source .env; set +a
#
# Every variable below is OPTIONAL. Blacksmith's default single-provider
# (Claude) path needs none of them.

# Phase 8 cross-provider judge — DeepSeek API transport.
# Declared by name in factory/policies/crosscheck.yml (deepseek.api_key_env).
# That file ships `deepseek.enabled: auto`, which resolves against this key:
# set it and the provider is on, leave it empty and the provider is silently
# off. `mode` (shadow vs active) is a separate, non-per-machine field the
# committed policy sets the same way on every clone — read crosscheck.yml
# itself rather than assume shadow or active here.
# docs/runbooks/providers.md §1.
DEEPSEEK_API_KEY=

# Codex (the other Phase 8 provider) needs NO key here — it uses the `codex`
# CLI's own ChatGPT-subscription session established once by `codex login`.

# OpenRouter — one key, two jobs (docs/runbooks/providers.md §9). Wire-
# compatible with the same OpenAI chat/completions transport, so it needs no
# separate module. (a) Substitute: if codex or deepseek's own precondition is
# unmet on this box and this key is set, that provider runs through
# OpenRouter instead, keeping its name, `mode` and gating power — see each
# provider's `openrouter_fallback.model` in factory/policies/crosscheck.yml.
# (b) Extra judges: list further OpenRouter model ids in OPENROUTER_MODELS
# below to add them as providers named `openrouter:<model>`, each starting
# `mode: shadow` until promoted (calibration rule, §3). A project can also
# add or override providers via its own .blacksmith/crosscheck.yml.
OPENROUTER_API_KEY=

# Comma-separated OpenRouter model ids for the extra judges above, e.g.
# `google/gemini-3-pro,qwen/qwen4-max`. Ignored if OPENROUTER_API_KEY is
# empty. docs/runbooks/providers.md §9b.
OPENROUTER_MODELS=

# ---------------------------------------------------------------------------
# Budget caps — a per-BOX override of factory/policies/budgets.yml.
#
# budgets.yml stays the committed default, sized per effort tier (small /
# medium / huge): a reader takes the tier the epic runs at (the plan's
# `effort` after effort.yml's security floor, else `default_tier`). A value
# set here replaces budgets.yml's number for every epic run on this box
# while it is set (not per epic — there is still no per-epic override).
# Every smith verb reads the policy through one loader, so an override
# reaches all of them or none.
#
# Each knob comes in four names. Highest first:
#   1. <NAME>_SMALL / <NAME>_MEDIUM / <NAME>_HUGE — that tier only;
#   2. <NAME> — every tier that has no suffixed value of its own;
#   3. budgets.yml's number for the tier.
# So a bare <NAME> pins small, medium and huge to one number. A value that is
# not valid, under any of the four names, stops the verb with
# `budgets.invalid-env`, naming the variable. Empty means "no override".
# Prefer the tier names: a bare name left in an older .env pins every tier.
# `budget alarm` and `wave check` print the names (never the values) of the
# knobs whose value differs from budgets.yml, as `budgetEnvOverrides`.
#
# Every line below ships empty or commented out, so copying this file changes
# nothing. Each commented tier line shows budgets.yml's current number for
# that tier; uncomment one to change it. While a line is set in `.env`, a
# later edit to that number in budgets.yml does not reach this box.
# ---------------------------------------------------------------------------

# Token cap for one whole epic: planner + every worker + every judge. Tokens,
# a positive integer (digits only). Read by `budget alarm`, `wave check` (the
# epic headroom a wave must fit under) and `plan quorum`. budgets.yml
# epic.cap_tokens (one number per tier).
SMITH_EPIC_CAP_TOKENS=
# SMITH_EPIC_CAP_TOKENS_SMALL=4000000
# SMITH_EPIC_CAP_TOKENS_MEDIUM=16000000
# SMITH_EPIC_CAP_TOKENS_HUGE=32000000

# Share of the epic cap at which `budget alarm` exits 1 and the planner must
# re-plan or ask the operator. A ratio, a decimal in (0, 1]. budgets.yml
# epic.alarm_ratio (the same for every tier).
SMITH_EPIC_ALARM_RATIO=
# SMITH_EPIC_ALARM_RATIO_SMALL=0.7
# SMITH_EPIC_ALARM_RATIO_MEDIUM=0.7
# SMITH_EPIC_ALARM_RATIO_HUGE=0.7

# Most of an epic's tasks in flight (admitted, not yet merged) at once;
# `wave check` refuses a wave that would exceed it. Tasks, a positive integer.
# Empty = off, which is budgets.yml's shipped value (epic.max_in_flight_tasks:
# null).
SMITH_EPIC_MAX_IN_FLIGHT_TASKS=
# SMITH_EPIC_MAX_IN_FLIGHT_TASKS_SMALL=
# SMITH_EPIC_MAX_IN_FLIGHT_TASKS_MEDIUM=
# SMITH_EPIC_MAX_IN_FLIGHT_TASKS_HUGE=

# Token cap per coder task: the default a planner sizes a task's budget
# against, the price `wave check` charges a follow-up task that declares no
# budget, the number `budget alarm` attributes coder spend against, and the
# cap_tokens `harness plan` renders for a coder turn. Tokens, a positive
# integer. budgets.yml task.coder.cap_tokens x task_tier_scale.
SMITH_TASK_CODER_CAP_TOKENS=
# SMITH_TASK_CODER_CAP_TOKENS_SMALL=110000
# SMITH_TASK_CODER_CAP_TOKENS_MEDIUM=220000
# SMITH_TASK_CODER_CAP_TOKENS_HUGE=440000

# Diff size a planner sizes a coder task against (lockfiles and generated
# files excluded). A planner-facing default: the gate checks the task's own
# declared number, not this one. Lines, a positive integer. budgets.yml
# task.coder.cap_diff_lines x task_tier_scale.
SMITH_TASK_CODER_CAP_DIFF_LINES=
# SMITH_TASK_CODER_CAP_DIFF_LINES_SMALL=350
# SMITH_TASK_CODER_CAP_DIFF_LINES_MEDIUM=700
# SMITH_TASK_CODER_CAP_DIFF_LINES_HUGE=1400

# Token cap per tester turn, as `harness plan` renders it and `budget alarm`
# attributes it. Tokens, a positive integer. budgets.yml
# task.tester.cap_tokens x task_tier_scale.
SMITH_TASK_TESTER_CAP_TOKENS=
# SMITH_TASK_TESTER_CAP_TOKENS_SMALL=30000
# SMITH_TASK_TESTER_CAP_TOKENS_MEDIUM=60000
# SMITH_TASK_TESTER_CAP_TOKENS_HUGE=120000

# Token cap per planner turn, as `harness plan` renders it and `budget alarm`
# attributes it. Tokens, a positive integer. budgets.yml
# task.planner.cap_tokens x task_tier_scale.
SMITH_TASK_PLANNER_CAP_TOKENS=
# SMITH_TASK_PLANNER_CAP_TOKENS_SMALL=55000
# SMITH_TASK_PLANNER_CAP_TOKENS_MEDIUM=110000
# SMITH_TASK_PLANNER_CAP_TOKENS_HUGE=220000

# Token cap per researcher turn, as `harness plan` renders it and `budget alarm`
# attributes it. Tokens, a positive integer. budgets.yml
# task.researcher.cap_tokens x task_tier_scale.
SMITH_TASK_RESEARCHER_CAP_TOKENS=
# SMITH_TASK_RESEARCHER_CAP_TOKENS_SMALL=40000
# SMITH_TASK_RESEARCHER_CAP_TOKENS_MEDIUM=80000
# SMITH_TASK_RESEARCHER_CAP_TOKENS_HUGE=160000

# Token cap per spec-reviewer turn, as `harness plan` renders it and `budget alarm`
# attributes it. Tokens, a positive integer. budgets.yml
# task.spec-reviewer.cap_tokens x task_tier_scale.
SMITH_TASK_SPEC_REVIEWER_CAP_TOKENS=
# SMITH_TASK_SPEC_REVIEWER_CAP_TOKENS_SMALL=85000
# SMITH_TASK_SPEC_REVIEWER_CAP_TOKENS_MEDIUM=170000
# SMITH_TASK_SPEC_REVIEWER_CAP_TOKENS_HUGE=340000

# Token cap per grader turn, as `harness plan` renders it and `budget alarm`
# attributes it. Tokens, a positive integer. budgets.yml
# task.grader.cap_tokens x task_tier_scale.
SMITH_TASK_GRADER_CAP_TOKENS=
# SMITH_TASK_GRADER_CAP_TOKENS_SMALL=55000
# SMITH_TASK_GRADER_CAP_TOKENS_MEDIUM=110000
# SMITH_TASK_GRADER_CAP_TOKENS_HUGE=220000

# Token cap per reviewer turn, as `harness plan` renders it and `budget alarm`
# attributes it. Tokens, a positive integer. budgets.yml
# task.reviewer.cap_tokens x task_tier_scale.
SMITH_TASK_REVIEWER_CAP_TOKENS=
# SMITH_TASK_REVIEWER_CAP_TOKENS_SMALL=30000
# SMITH_TASK_REVIEWER_CAP_TOKENS_MEDIUM=60000
# SMITH_TASK_REVIEWER_CAP_TOKENS_HUGE=120000

# Token cap per verifier turn, as `harness plan` renders it and `budget alarm`
# attributes it. Tokens, a positive integer. budgets.yml
# task.verifier.cap_tokens x task_tier_scale.
SMITH_TASK_VERIFIER_CAP_TOKENS=
# SMITH_TASK_VERIFIER_CAP_TOKENS_SMALL=20000
# SMITH_TASK_VERIFIER_CAP_TOKENS_MEDIUM=40000
# SMITH_TASK_VERIFIER_CAP_TOKENS_HUGE=80000

# Token cap per security-reviewer turn, as `harness plan` renders it and `budget alarm`
# attributes it. Tokens, a positive integer. budgets.yml
# task.security-reviewer.cap_tokens x task_tier_scale.
SMITH_TASK_SECURITY_REVIEWER_CAP_TOKENS=
# SMITH_TASK_SECURITY_REVIEWER_CAP_TOKENS_SMALL=40000
# SMITH_TASK_SECURITY_REVIEWER_CAP_TOKENS_MEDIUM=80000
# SMITH_TASK_SECURITY_REVIEWER_CAP_TOKENS_HUGE=160000

# Token cap per auditor turn, as `harness plan` renders it and `budget alarm`
