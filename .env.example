# Blacksmith — template for `.env`. This file is the ONLY committed env file
# (docs/standards/guardrails.md "Secrets, keys, tokens"). A secret appears
# here by NAME only, never with a value. The SMITH_* tuning knobs further down
# are not secrets: each carries its shipped default, which a test holds equal
# to budgets.yml or the agent template it mirrors (test/envExample.test.ts).
# Copy it: `cp .env.example .env`, then fill `.env`.
#
# The CLI loads this file's sibling `.env` at start (D-270,
# factory/orchestrator/src/dotenv.ts) — no dotenv dependency, no script to
# source. It sets only names the environment does not already hold, so an
# exported value always beats the file:
#
#   DEEPSEEK_API_KEY=... smith judge preflight          # wins over .env
#   SMITH_EPIC_CAP_TOKENS=... smith budget alarm <id>   # so does this
#
# Anything that is not the CLI — a shell, a test runner, a tool of your own —
# still reads process.env at call time, so load it yourself there:
#
#   node --env-file=.env factory/orchestrator/dist/cli.js <ns> <action> ...
#   set -a; source .env; set +a
#
# Every variable below is OPTIONAL. Blacksmith's default single-provider
# (Claude) path needs none of them.

# Phase 8 cross-provider judge — DeepSeek API transport.
# Declared by name in factory/policies/crosscheck.yml (deepseek.api_key_env).
# That file ships `deepseek.enabled: auto`, which resolves against this key:
# set it and the provider is on, leave it empty and the provider is silently
# off. It ships `mode: shadow`, so it is called and recorded and does not vote
# until an operator promotes it.
# docs/runbooks/providers.md §1.
DEEPSEEK_API_KEY=

# Codex (the other Phase 8 provider) needs NO key here — it uses the `codex`
# CLI's own ChatGPT-subscription session established once by `codex login`.

# ---------------------------------------------------------------------------
# Budget caps — a per-BOX override of factory/policies/budgets.yml.
#
# budgets.yml stays the committed default; a value set here replaces that one
# number for every epic run on this box while it is set (not per epic — there
# is still no per-epic override). Every smith verb reads the policy through
# one loader, so an override reaches all of them or none. A value that is not
# valid stops the verb with `budgets.invalid-env`, naming the variable. Empty
# means "no override". `budget alarm` and `wave check` print the names (never
# the values) of the knobs whose value differs from budgets.yml, as
# `budgetEnvOverrides`.
#
# Each line below holds budgets.yml's current value, so copying this file
# changes nothing. It does pin it: while a line is set in `.env`, a later edit
# to that number in budgets.yml does not reach this box. Delete the lines you
# do not mean to change.
# ---------------------------------------------------------------------------

# Token cap for one whole epic: planner + every worker + every judge. Tokens,
# a positive integer (digits only). Read by `budget alarm`, `wave check` (the
# epic headroom a wave must fit under) and `plan quorum`. budgets.yml
# epic.cap_tokens.
SMITH_EPIC_CAP_TOKENS=4000000

# Share of the epic cap at which `budget alarm` exits 1 and the planner must
# re-plan or ask the operator. A ratio, a decimal in (0, 1]. budgets.yml
# epic.alarm_ratio.
SMITH_EPIC_ALARM_RATIO=0.7

# Most of an epic's tasks in flight (admitted, not yet merged) at once;
# `wave check` refuses a wave that would exceed it. Tasks, a positive integer.
# Empty = off, which is budgets.yml's shipped value (epic.max_in_flight_tasks:
# null).
SMITH_EPIC_MAX_IN_FLIGHT_TASKS=

# Token cap per coder task: the default a planner sizes a task's budget
# against, the price `wave check` charges a follow-up task that declares no
# budget, the number `budget alarm` attributes coder spend against, and the
# cap_tokens `harness plan` renders for a coder turn. Tokens, a positive
# integer. budgets.yml task.coder.cap_tokens.
SMITH_TASK_CODER_CAP_TOKENS=150000

# Diff size a planner sizes a coder task against (lockfiles and generated
# files excluded). A planner-facing default: the gate checks the task's own
# declared number, not this one. Lines, a positive integer. budgets.yml
# task.coder.cap_diff_lines.
SMITH_TASK_CODER_CAP_DIFF_LINES=400

# Token cap per researcher turn, as `harness plan` renders it and `budget
# alarm` attributes it. Tokens, a positive integer. budgets.yml
# task.researcher.cap_tokens.
SMITH_TASK_RESEARCHER_CAP_TOKENS=60000

# Token cap per judge turn (spec-reviewer, reviewer, verifier, grader), as
# `harness plan` renders it and `budget alarm` attributes it. Tokens, a
# positive integer. budgets.yml task.judges.cap_tokens.
SMITH_TASK_JUDGES_CAP_TOKENS=40000

# ---------------------------------------------------------------------------
# Agent turn caps — one per role template in .claude/agents/.
#
# A turn cap is per ROLE, never per task: Claude Code reads it from the
# template's frontmatter `maxTurns:` when it spawns the agent, so setting a
# variable here does NOTHING until you run
#
#   smith agents sync            # rewrite each template's maxTurns: line
#   smith agents sync --dry-run  # print role / from / to, write nothing
#   smith agents sync --reset    # put back the value committed at git HEAD
#
# The rewrite is a local, uncommitted edit by design — do not commit it. An
# agent session that is already running keeps the cap it was spawned with.
# Name: SMITH_MAXTURNS_<ROLE>, role upper-cased with `-` as `_`. Turns, a
# positive integer (digits only); an unknown role or a bad value refuses the
# whole sync and writes nothing. Each line holds the committed template value.
# ---------------------------------------------------------------------------

# Most turns one auditor agent may take (.claude/agents/auditor.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_AUDITOR=15

# Most turns one coder agent may take (.claude/agents/coder.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_CODER=40

# Most turns one grader agent may take (.claude/agents/grader.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_GRADER=15

# Most turns one merger agent may take (.claude/agents/merger.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_MERGER=20

# Most turns one planner agent may take (.claude/agents/planner.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_PLANNER=40

# Most turns one researcher agent may take (.claude/agents/researcher.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_RESEARCHER=15

# Most turns one reviewer agent may take (.claude/agents/reviewer.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_REVIEWER=15

# Most turns one scribe agent may take (.claude/agents/scribe.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_SCRIBE=15

# Most turns one security-reviewer agent may take (.claude/agents/security-reviewer.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_SECURITY_REVIEWER=15

# Most turns one spec-reviewer agent may take (.claude/agents/spec-reviewer.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_SPEC_REVIEWER=15

# Most turns one tester agent may take (.claude/agents/tester.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_TESTER=30

# Most turns one uiux agent may take (.claude/agents/uiux.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_UIUX=15

# Most turns one verifier agent may take (.claude/agents/verifier.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_VERIFIER=15

# Most turns one wave-runner agent may take (.claude/agents/wave-runner.md). Turns, a
# positive integer. Applied by `smith agents sync`, read by Claude Code at spawn.
SMITH_MAXTURNS_WAVE_RUNNER=60
